<MainApp>

<ExperimentLayout>:

    button_green: button_green
    button_red: button_red
    spot: spot
    label_top_right: label_top_right
    label_top_left: label_top_left
    label_bottom_left: label_bottom_left
    panel_connected_label: panel_connected_label
    session_ended_label: session_ended_label


    BasicImageButtonGreen:  
        id: button_green
        source: 'assets/images/green_light.png'
        size_hint: .15, .15
        pos_hint:  {'center_x':.7, 'center_y': self.parent.button_height}
        on_parent: app.set_clicker(self); app.set_writer(self), app.set_injector(self)


    BasicImageButtonRed:  
        id: button_red
        source: 'assets/images/red_light.png'
        size_hint: .15, .15
        pos_hint:  {'center_x':.6, 'center_y': self.parent.button_height} 
        on_parent: app.set_clicker(self); app.set_writer(self), app.set_injector(self)

    Label:
        id: label_top_right
        pos_hint:  {'center_x':.95, 'center_y':.95} 
        text: "??"
        font_size: '56sp'
        bold: True
        color: 0.2, 0.2, 0.2, 0.8

    Label:
        id: label_top_left
        pos_hint:  {'center_x':.05, 'center_y':.95} 
        text: "??"
        font_size: '56sp'
        bold: True
        color: 0.2, 0.2, 0.2, 0.8
    
    Label:
        id: label_bottom_left
        pos_hint:  {'center_x':.05, 'center_y':.05} 
        text: "??"
        font_size: '56sp'
        bold: True
        color: 0.2, 0.2, 0.2, 0.8

    Label:
        id: panel_connected_label
        pos_hint:  {'center_x':.5, 'center_y':.15} 
        text: root.initial_panel_connected_text()
        font_size: '56sp'
        bold: True
        color: root.initial_panel_connected_color()

    Label:
        id: session_ended_label
        pos_hint:  {'center_x':.5, 'center_y':.15} 
        text: root.initial_session_ended_text()
        font_size: '56sp'
        bold: True
        color: root.initial_session_ended_color()

    Image:
        id: spot
        source: 'assets/images/spot.png'
        size: self.texture_size